# Переменные для docker-compose.yml (используется и локально, и на сервере).
# Скопируйте в .env и при необходимости поправьте значения.

# --- PostgreSQL (сервис db) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=films

# --- pgAdmin (http://localhost:8080) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- Backend (значения должны соответствовать POSTGRES_* выше) ---
DATABASE_DRIVER=postgres
DATABASE_PORT=5432
DATABASE_NAME=films
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
# dev (цветной вывод) | json | tskv
LOG_FORMAT=json
